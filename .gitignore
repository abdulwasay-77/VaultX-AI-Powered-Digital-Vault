########################################
# VaultX - Root .gitignore
########################################

# ======================================
# Secrets / Environment
# ======================================
.env
.env.*
!.env.example

vaultx_backend/.env
vaultx_backend/.env.*
!vaultx_backend/.env.example

# ======================================
# Python
# ======================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

*.egg-info/
.installed.cfg
*.egg

venv/
.venv/
env/
ENV/
vaultx_backend/venv/
vaultx_backend/.venv/

.pytest_cache/
.coverage
htmlcov/

# ======================================
# PyInstaller build output (compiled backend)
# ======================================
# NOTE: the root-level /build/ and /dist/ rules above only match a build/dist
# folder sitting directly in the repo root — they do NOT catch these nested
# ones, which is where the actual compiled .exe, DLLs, and generated SQLite
# database now live. These must NOT be committed (large, generated, and the
# .db file may contain real test data from your machine).
vaultx_backend/build/
vaultx_backend/dist/

# The database + uploads/backups PyInstaller creates next to the exe when run
vaultx_backend/data/

# ======================================
# Runtime Data
# ======================================
vaultx_backend/uploads/*
!vaultx_backend/uploads/.gitkeep

vaultx_backend/backups/*
!vaultx_backend/backups/.gitkeep

*.encrypted
*.vaultx

# ======================================
# Flutter / Dart
# ======================================
vaultx_frontend/.dart_tool/
vaultx_frontend/.flutter-plugins
vaultx_frontend/.flutter-plugins-dependencies
vaultx_frontend/.packages
vaultx_frontend/build/
vaultx_frontend/.pub-cache/
vaultx_frontend/.pub/
vaultx_frontend/*.iml

vaultx_frontend/android/.gradle/
vaultx_frontend/android/app/build/

vaultx_frontend/ios/Pods/
vaultx_frontend/ios/Flutter/Flutter.podspec

vaultx_frontend/windows/flutter/ephemeral/
vaultx_frontend/linux/flutter/ephemeral/
vaultx_frontend/macos/Flutter/ephemeral/

# Generated Flutter files
vaultx_frontend/windows/flutter/generated_plugin_registrant.cc
vaultx_frontend/windows/flutter/generated_plugin_registrant.h
vaultx_frontend/windows/flutter/generated_plugins.cmake

# ======================================
# Editors
# ======================================
.vscode/
.idea/
*.swp
*.swo

# ======================================
# OS
# ======================================
.DS_Store
Thumbs.db

# ======================================
# Databases
# ======================================
*.db
*.sqlite3

# ======================================
# Logs / Temp
# ======================================
*.log
*.tmp
*.temp

# ======================================
# Installer output (Inno Setup)
# ======================================
# The final VaultX-Setup.exe and any Inno Setup work files — this is a
# generated *product* of the source, not source itself, and is large.
# Anyone with the repo can rebuild it using vaultx_installer.iss.
installer_output/
*.exe